<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The Contracts folder is its own project (ADR-0001). Keep its files out of this project. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Contracts/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Iron.Core/Iron.Core.csproj" />
    <ProjectReference Include="../Iron.Data/Iron.Data.csproj" />
    <ProjectReference Include="../Iron.Api/Iron.Api.csproj" />
    <ProjectReference Include="../Iron.Security/Iron.Security.csproj" />
    <ProjectReference Include="Contracts/Iron.Fleet.Contracts.csproj" />
    <ProjectReference Include="../Iron.Audit/Contracts/Iron.Audit.Contracts.csproj" />
    <ProjectReference Include="../Iron.Tenancy/Contracts/Iron.Tenancy.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Storage.Blobs" />
    <!-- Design-time only: lets "dotnet ef migrations add" run with this project as the start-up project. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
