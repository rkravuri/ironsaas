<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IronLayer>Kernel</IronLayer>
    <!-- The Contracts folder is its own project (ADR-0001). Keep its files out of this project. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Contracts/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Iron.Kernel/Iron.Kernel.csproj" />
    <ProjectReference Include="../Iron.Kernel.Data/Iron.Kernel.Data.csproj" />
    <ProjectReference Include="../Iron.Kernel.Api/Iron.Kernel.Api.csproj" />
    <ProjectReference Include="Contracts/Iron.Kernel.Tenancy.Contracts.csproj" />
    <ProjectReference Include="../Iron.Kernel.Audit/Contracts/Iron.Kernel.Audit.Contracts.csproj" />
    <ProjectReference Include="../Iron.Kernel.Fleet/Contracts/Iron.Kernel.Fleet.Contracts.csproj" />
    <ProjectReference Include="../Iron.Kernel.Security/Iron.Kernel.Security.csproj" />
    <ProjectReference Include="../Iron.Kernel.Entitlements/Contracts/Iron.Kernel.Entitlements.Contracts.csproj" />
    <ProjectReference Include="../Iron.Kernel.Flags/Contracts/Iron.Kernel.Flags.Contracts.csproj" />
    <ProjectReference Include="../Iron.Kernel.Authorization/Contracts/Iron.Kernel.Authorization.Contracts.csproj" />
    <ProjectReference Include="../Iron.Kernel.Identity/Contracts/Iron.Kernel.Identity.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- What the units of this build can license, written by make catalogue (ADR-0034); the control plane image carries it. -->
    <EmbeddedResource Include="Services/licensing-catalogue.json" LogicalName="Iron.Kernel.Tenancy.Services.licensing-catalogue.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" />
    <!-- Design-time only: lets "dotnet ef migrations add" run with this project as the start-up project. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
