<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IronLayer>Kernel</IronLayer>
    <!-- The Contracts folder is its own project (ADR-0001). Keep its files out of this project. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Contracts/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Iron.Kernel/Iron.Kernel.csproj" />
    <ProjectReference Include="../Iron.Kernel.Data/Iron.Kernel.Data.csproj" />
    <ProjectReference Include="../Iron.Kernel.Api/Iron.Kernel.Api.csproj" />
    <ProjectReference Include="../Iron.Kernel.Telemetry/Iron.Kernel.Telemetry.csproj" />
    <ProjectReference Include="../Iron.Kernel.Security/Iron.Kernel.Security.csproj" />
    <ProjectReference Include="Contracts/Iron.Kernel.Identity.Contracts.csproj" />
    <ProjectReference Include="../Iron.Kernel.Audit/Contracts/Iron.Kernel.Audit.Contracts.csproj" />
    <ProjectReference Include="../Iron.Kernel.Authorization/Contracts/Iron.Kernel.Authorization.Contracts.csproj" />
    <ProjectReference Include="../Iron.Kernel.Settings/Contracts/Iron.Kernel.Settings.Contracts.csproj" />
    <ProjectReference Include="../Iron.Kernel.Compliance/Contracts/Iron.Kernel.Compliance.Contracts.csproj" />
    <ProjectReference Include="../Iron.Kernel.Protection/Contracts/Iron.Kernel.Protection.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The common-password list the policy refuses (TF-012, ADR-0046): the NCSC's 100,000, through SecLists (MIT, docs/licences.md). -->
    <EmbeddedResource Include="Services/common-passwords.txt" LogicalName="Iron.Kernel.Identity.Services.common-passwords.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" />
    <PackageReference Include="Fido2" />
    <PackageReference Include="MaxMind.Db" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <!-- Design-time only: lets "dotnet ef migrations add" run with this project as the start-up project. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
