<Project Sdk="Microsoft.NET.Sdk">

  <!-- Iron.Kernel.Data: database conventions for every module (ADR-0008). -->
  <PropertyGroup>
    <IronLayer>Kernel</IronLayer>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Iron.Kernel/Iron.Kernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
  </ItemGroup>

  <ItemGroup>
    <!-- Design-time only: lets "dotnet ef migrations add" run for the data library's own context (kernel_data). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
