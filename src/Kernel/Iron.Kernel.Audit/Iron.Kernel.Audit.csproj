<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IronLayer>Kernel</IronLayer>
    <!-- The Contracts folder is its own project (ADR-0001). Keep its files out of this project. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Contracts/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Iron.Kernel/Iron.Kernel.csproj" />
    <ProjectReference Include="../Iron.Kernel.Data/Iron.Kernel.Data.csproj" />
    <ProjectReference Include="../Iron.Kernel.Api/Iron.Kernel.Api.csproj" />
    <ProjectReference Include="../Iron.Kernel.Telemetry/Iron.Kernel.Telemetry.csproj" />
    <ProjectReference Include="Contracts/Iron.Kernel.Audit.Contracts.csproj" />
    <ProjectReference Include="../Iron.Kernel.Authorization/Contracts/Iron.Kernel.Authorization.Contracts.csproj" />
    <!-- The archive, record copies and exports go to the tenant's container (ADR-0050). -->
    <ProjectReference Include="../Iron.Kernel.Files/Contracts/Iron.Kernel.Files.Contracts.csproj" />
    <ProjectReference Include="../Iron.Kernel.Compliance/Contracts/Iron.Kernel.Compliance.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Design-time only: lets "dotnet ef migrations add" run with this project as the start-up project. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
