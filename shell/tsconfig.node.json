{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "eslint.config.js",
    "lint/suite-imports.d.ts",
    "playwright.config.ts",
    "playwright.a11y.config.ts"
  ]
}
