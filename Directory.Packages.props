<Project>

  <!--
    Central package versions (ADR-0003).
    Every NuGet package used anywhere in the repository is listed here exactly once, with its licence.
    A project references a package by name only: <PackageReference Include="xunit.v3" />.
    Rule: open source with a licence that allows commercial use at no cost. A commercial
    component needs its own ADR. Versions are exact and are upgraded on purpose.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Data">
    <!-- Entity Framework Core (MIT). All Microsoft.EntityFrameworkCore.* packages stay on the same version. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
    <!-- Npgsql provider for EF Core (PostgreSQL licence). -->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- snake_case table and column names (Apache-2.0). -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
  </ItemGroup>

  <ItemGroup Label="Api">
    <!-- Request validation with a fluent interface (Apache-2.0). -->
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <!-- Argon2id for password hashing (MIT, managed code). -->
    <PackageVersion Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <!-- OpenAPI document generation (MIT), same version train as the runtime. -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <!-- Interactive API reference on top of the OpenAPI document (MIT). Development only. -->
    <PackageVersion Include="Scalar.AspNetCore" Version="2.17.3" />
  </ItemGroup>

  <ItemGroup Label="Telemetry">
    <!-- OpenTelemetry SDK, hosting integration and OTLP exporter (Apache-2.0). Same version train. -->
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
    <!-- ASP.NET Core and HttpClient instrumentation (Apache-2.0). -->
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
    <!-- Health checks for class libraries (MIT), same train as the runtime. -->
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <!-- In-memory span exporter for telemetry tests (Apache-2.0). -->
    <PackageVersion Include="OpenTelemetry.Exporter.InMemory" Version="1.19.1" />
    <!-- In-memory ASP.NET Core server for API tests (MIT). -->
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <!-- xUnit.net v3 (Apache-2.0). Runs on Microsoft Testing Platform v2; the runner is selected in global.json. -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <!-- Throw-away PostgreSQL containers for integration tests (MIT). -->
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <!-- FakeTimeProvider for tests (MIT). -->
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.9.0" />
  </ItemGroup>

</Project>
