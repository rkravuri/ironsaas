<Project>

  <!--
    Central package versions (ADR-0003).
    Every NuGet package used anywhere in the repository is listed here exactly once, with its licence.
    A project references a package by name only: <PackageReference Include="xunit.v3" />.
    Rule: open source with a licence that allows commercial use at no cost. A commercial
    component needs its own ADR. Versions are exact and are upgraded on purpose.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Data">
    <!-- Entity Framework Core (MIT). All Microsoft.EntityFrameworkCore.* packages stay on the same version. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
    <!-- Npgsql provider for EF Core (PostgreSQL licence). -->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- snake_case table and column names (Apache-2.0). -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
  </ItemGroup>

  <ItemGroup Label="Api">
    <!-- Request validation with a fluent interface (Apache-2.0). -->
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <!-- HTML sanitiser for rich text by an allow-list (MIT, mganss/HtmlSanitizer, on AngleSharp, MIT): S3 T9a, ADR-0053. 9.2.1039 of 2026-08-28, the newest stable. -->
    <PackageVersion Include="HtmlSanitizer" Version="9.2.1039" />
    <!-- Argon2id for password hashing (MIT, managed code). -->
    <PackageVersion Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <!-- JWT creation and validation (MIT). OpenIddict (7.7.2 today) joins when the authorization code flow arrives. -->
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
    <!-- WebAuthn for passkeys (MIT, Fido2NetLib): registration and assertion, attestation formats, the COSE keys (S3 T3, ADR-0047). 4.2.0 of 2026-10-02, the newest at least two weeks old. -->
    <PackageVersion Include="Fido2" Version="4.3.0" />
    <!-- Reads the bundled IP-to-city database in MMDB form for a session's approximate location (Apache-2.0, S3 T5, ADR-0049). 5.2.0 of 2026-09-10, the newest at least two weeks old. -->
    <PackageVersion Include="MaxMind.Db" Version="5.2.0" />
    <!-- Azure Blob Storage SDK (MIT); Azurite on the laptop (ADR-0006). -->
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.30.1" />
    <!-- OpenAPI document generation (MIT), same version train as the runtime. -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <!-- Interactive API reference on top of the OpenAPI document (MIT). Development only. -->
    <PackageVersion Include="Scalar.AspNetCore" Version="2.18.0" />
    <!-- The OpenFeature SDK (Apache-2.0, CNCF): flags evaluated through one interface, provider chosen by configuration (ADR-0035). 2.14.1 of 2026-08-10. -->
    <PackageVersion Include="OpenFeature" Version="2.14.1" />
  </ItemGroup>

  <ItemGroup Label="Telemetry">
    <!-- OpenTelemetry SDK, hosting integration and OTLP exporter (Apache-2.0). Same version train. -->
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.0" />
    <!-- ASP.NET Core and HttpClient instrumentation (Apache-2.0). -->
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.19.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.19.0" />
    <!-- Health checks for class libraries (MIT), same train as the runtime. -->
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <!-- In-memory span exporter for telemetry tests (Apache-2.0). -->
    <PackageVersion Include="OpenTelemetry.Exporter.InMemory" Version="1.20.0" />
    <!-- In-memory ASP.NET Core server for API tests (MIT). -->
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <!-- xUnit.net v3 (Apache-2.0). Runs on Microsoft Testing Platform v2; the runner is selected in global.json. -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <!-- xUnit's extension points for a library (Apache-2.0), the version xunit.v3 brings: Iron.Testing's attributes
         that say what a test proves are traits (ADR-0044). -->
    <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.2" />
    <!-- The C# compiler as a library (MIT), so a test proves that paging a raw business record query does not compile
         (ADR-0032). The version Entity Framework's design package already brings, so the graph keeps one Roslyn. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <!-- Iron.Testing.Analyzers is built against the same Roslyn: the analyzer that refuses a test without what it proves
         (ADR-0044) loads into the SDK's compiler, which must be as new as the version it was built against. -->
    <!-- Throw-away PostgreSQL containers for integration tests (MIT). -->
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="Testcontainers" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.Azurite" Version="4.16.0" />
    <!-- FakeTimeProvider for tests (MIT). -->
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <!-- Line coverage of the test run on Microsoft Testing Platform (MIT, coverlet-coverage/coverlet): the coverage floor,
         TF-077 AC4, ADR-0055. 10.1.0 of 2026-09-27, the newest at least two weeks old. Microsoft's own coverage extension
         is not open source, so it is not used. -->
    <PackageVersion Include="coverlet.MTP" Version="10.1.0" />
  </ItemGroup>

</Project>
