<Project Sdk="Microsoft.NET.Sdk">

  <!--
    What every test project shares: the platform services the integration tests run on (PostgreSQL, Azurite and
    OpenBao; under make test one container of each serves the whole run, tests/test-services.sh, and a project run alone
    starts its own with Testcontainers), and the attributes that say what a test proves (ADR-0044).
  -->
  <PropertyGroup>
    <IronLayer>Test</IronLayer>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Testcontainers" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.Azurite" />
    <PackageReference Include="xunit.v3.extensibility.core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Kernel/Iron.Kernel/Iron.Kernel.csproj" />
    <ProjectReference Include="../../src/Kernel/Iron.Kernel.Data/Iron.Kernel.Data.csproj" />
  </ItemGroup>

</Project>
