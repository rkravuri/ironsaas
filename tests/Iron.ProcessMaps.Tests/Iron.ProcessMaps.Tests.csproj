<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Proves the process maps' check (ADR-0045): a sound map passes, and each rule broken once is named with its file and
    line; the packs' maps in docs/prd pass as committed. No services: it reads files only.
  -->
  <PropertyGroup>
    <IronLayer>Test</IronLayer>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Iron.Testing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Iron.Testing/Iron.Testing.csproj" />
    <ProjectReference Include="../../tools/Iron.ProcessMaps/Iron.ProcessMaps.csproj" />
  </ItemGroup>

</Project>
