<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests of the REST conventions against an in-memory ASP.NET Core server. No Docker needed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Iron.Core/Iron.Core.csproj" />
    <ProjectReference Include="../../src/Iron.Data/Iron.Data.csproj" />
    <ProjectReference Include="../../src/Iron.Api/Iron.Api.csproj" />
  </ItemGroup>

</Project>
