<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tests of the pure rules, and integration tests against a throw-away PostgreSQL container (needs Docker). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Kernel/Iron.Kernel/Iron.Kernel.csproj" />
    <ProjectReference Include="../../src/Iron.Data/Iron.Data.csproj" />
  </ItemGroup>

</Project>
