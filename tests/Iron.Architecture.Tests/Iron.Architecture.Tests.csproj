<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Architecture checks (ADR-0001, ADR-0004). Plain xUnit tests that read the project files and the
    compiled assemblies of the repository and fail with the file to fix. They run in `make test`,
    `make check` and in CI. xUnit.net v3 test projects are executables: `dotnet run` also works here.
  -->
  <PropertyGroup>
    <IronLayer>Test</IronLayer>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Iron.Testing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- What a test proves (ADR-0044). -->
  <ItemGroup>
    <ProjectReference Include="../Iron.Testing/Iron.Testing.csproj" />
  </ItemGroup>

  <!--
    Every module, Contracts and host project is referenced so that its compiled assembly lands next to
    this test, where AssemblyReferenceTests reads it. A project missing here fails that test by name.
  -->
  <ItemGroup>
    <ProjectReference Include="../../src/Kernel/Iron.Kernel/Iron.Kernel.csproj" />
    <ProjectReference Include="../../src/Kernel/Iron.Kernel.Data/Iron.Kernel.Data.csproj" />
    <ProjectReference Include="../../src/Kernel/Iron.Kernel.Api/Iron.Kernel.Api.csproj" />
    <ProjectReference Include="../../src/Kernel/Iron.Kernel.Telemetry/Iron.Kernel.Telemetry.csproj" />
