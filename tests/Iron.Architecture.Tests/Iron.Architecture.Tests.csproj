<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Architecture checks (ADR-0001, ADR-0004). Plain xUnit tests that read the project files and the
    compiled assemblies of the repository and fail with the file to fix. They run in `make test`,
    `make check` and in CI. xUnit.net v3 test projects are executables: `dotnet run` also works here.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Every module, Contracts and host project is referenced so that its compiled assembly lands next to
    this test, where AssemblyReferenceTests reads it. A project missing here fails that test by name.
  -->
  <ItemGroup>
    <ProjectReference Include="../../src/Kernel/Iron.Kernel/Iron.Kernel.csproj" />
    <ProjectReference Include="../../src/Iron.Data/Iron.Data.csproj" />
    <ProjectReference Include="../../src/Iron.Api/Iron.Api.csproj" />
    <ProjectReference Include="../../src/Iron.Telemetry/Iron.Telemetry.csproj" />
    <ProjectReference Include="../../src/Iron.Security/Iron.Security.csproj" />
    <ProjectReference Include="../../src/Iron.Authorization/Iron.Authorization.csproj" />
    <ProjectReference Include="../../src/Iron.Authorization/Contracts/Iron.Authorization.Contracts.csproj" />
    <ProjectReference Include="../../src/Iron.Audit/Iron.Audit.csproj" />
    <ProjectReference Include="../../src/Iron.Audit/Contracts/Iron.Audit.Contracts.csproj" />
    <ProjectReference Include="../../src/Iron.Identity/Iron.Identity.csproj" />
    <ProjectReference Include="../../src/Iron.Identity/Contracts/Iron.Identity.Contracts.csproj" />
    <ProjectReference Include="../../src/Iron.Files/Iron.Files.csproj" />
    <ProjectReference Include="../../src/Iron.Files/Contracts/Iron.Files.Contracts.csproj" />
    <ProjectReference Include="../../src/Iron.Tenancy/Iron.Tenancy.csproj" />
    <ProjectReference Include="../../src/Iron.Tenancy/Contracts/Iron.Tenancy.Contracts.csproj" />
    <ProjectReference Include="../../src/Iron.Fleet/Iron.Fleet.csproj" />
    <ProjectReference Include="../../src/Iron.Fleet/Contracts/Iron.Fleet.Contracts.csproj" />
    <ProjectReference Include="../../src/Iron.Host.Api/Iron.Host.Api.csproj" />
    <ProjectReference Include="../../src/Iron.Host.Worker/Iron.Host.Worker.csproj" />
    <ProjectReference Include="../../src/Iron.Host.ControlPlane/Iron.Host.ControlPlane.csproj" />
    <ProjectReference Include="../../src/Iron.Host.Fleet/Iron.Host.Fleet.csproj" />
  </ItemGroup>

</Project>
