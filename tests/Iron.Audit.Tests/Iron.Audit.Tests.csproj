<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Audit module against a throw-away PostgreSQL container (needs Docker): the append-only table, the app role, the writer in a transaction, the search endpoint. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Iron.Core/Iron.Core.csproj" />
    <ProjectReference Include="../../src/Iron.Data/Iron.Data.csproj" />
    <ProjectReference Include="../../src/Iron.Api/Iron.Api.csproj" />
    <ProjectReference Include="../../src/Iron.Telemetry/Iron.Telemetry.csproj" />
    <ProjectReference Include="../../src/Iron.Audit/Iron.Audit.csproj" />
    <ProjectReference Include="../../src/Iron.Audit/Contracts/Iron.Audit.Contracts.csproj" />
    <ProjectReference Include="../../src/Iron.Authorization/Iron.Authorization.csproj" />
    <ProjectReference Include="../../src/Iron.Authorization/Contracts/Iron.Authorization.Contracts.csproj" />
  </ItemGroup>

</Project>
