    <ProjectReference Include="../../../../src/Kernel/Iron.Kernel.Flags/Iron.Kernel.Flags.csproj" />
    <ProjectReference Include="../../../../src/Suites/Procurement/Iron.Suites.Procurement.Purchasing/Iron.Suites.Procurement.Purchasing.csproj" />
    <ProjectReference Include="../../../../src/Suites/Procurement/Iron.Suites.Procurement.Purchasing/Contracts/Iron.Suites.Procurement.Purchasing.Contracts.csproj" />
