<Project Sdk="Microsoft.NET.Sdk">

  <!-- The eProcurement Suite's Purchasing module against a PostgreSQL container (needs Docker): its schema only in a unit that runs the suite, the installation its seed records, and the data a removed suite keeps. -->
  <PropertyGroup>
    <IronLayer>Test</IronLayer>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Iron.Testing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../Iron.Testing/Iron.Testing.csproj" />
    <ProjectReference Include="../../../../src/Kernel/Iron.Kernel/Iron.Kernel.csproj" />
    <ProjectReference Include="../../../../src/Kernel/Iron.Kernel.Data/Iron.Kernel.Data.csproj" />
    <ProjectReference Include="../../../../src/Kernel/Iron.Kernel.Api/Iron.Kernel.Api.csproj" />
    <ProjectReference Include="../../../../src/Kernel/Iron.Kernel.Audit/Iron.Kernel.Audit.csproj" />
