<Project Sdk="Microsoft.NET.Sdk">

  <!-- The unit's flags against a PostgreSQL container (needs Docker): the evaluation order, the stable hash, the refresh, the last known rules, OpenFeature, the kill switch. -->
  <PropertyGroup>
    <IronLayer>Test</IronLayer>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Iron.Testing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="OpenFeature" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Iron.Testing/Iron.Testing.csproj" />
    <ProjectReference Include="../../../src/Kernel/Iron.Kernel/Iron.Kernel.csproj" />
    <ProjectReference Include="../../../src/Kernel/Iron.Kernel.Data/Iron.Kernel.Data.csproj" />
    <ProjectReference Include="../../../src/Kernel/Iron.Kernel.Api/Iron.Kernel.Api.csproj" />
    <ProjectReference Include="../../../src/Kernel/Iron.Kernel.Telemetry/Iron.Kernel.Telemetry.csproj" />
    <ProjectReference Include="../../../src/Kernel/Iron.Kernel.Security/Iron.Kernel.Security.csproj" />
    <ProjectReference Include="../../../src/Kernel/Iron.Kernel.Audit/Iron.Kernel.Audit.csproj" />
    <ProjectReference Include="../../../src/Kernel/Iron.Kernel.Audit/Contracts/Iron.Kernel.Audit.Contracts.csproj" />
    <ProjectReference Include="../../../src/Kernel/Iron.Kernel.Authorization/Iron.Kernel.Authorization.csproj" />
    <ProjectReference Include="../../../src/Kernel/Iron.Kernel.Authorization/Contracts/Iron.Kernel.Authorization.Contracts.csproj" />
    <ProjectReference Include="../../../src/Kernel/Iron.Kernel.Flags/Iron.Kernel.Flags.csproj" />
    <ProjectReference Include="../../../src/Kernel/Iron.Kernel.Flags/Contracts/Iron.Kernel.Flags.Contracts.csproj" />
    <ProjectReference Include="../../../src/Kernel/Iron.Kernel.Events/Iron.Kernel.Events.csproj" />
  </ItemGroup>

</Project>
