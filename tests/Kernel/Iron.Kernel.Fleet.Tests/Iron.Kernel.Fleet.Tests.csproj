<Project Sdk="Microsoft.NET.Sdk">

  <!-- Provisioning against PostgreSQL, Azurite and OpenBao containers (needs Docker), with a recording unit runtime in place of Compose. -->
  <PropertyGroup>
    <IronLayer>Test</IronLayer>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Testcontainers" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.Azurite" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Azure.Storage.Blobs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/Kernel/Iron.Kernel/Iron.Kernel.csproj" />
    <ProjectReference Include="../../../src/Kernel/Iron.Kernel.Data/Iron.Kernel.Data.csproj" />
    <ProjectReference Include="../../../src/Kernel/Iron.Kernel.Api/Iron.Kernel.Api.csproj" />
    <ProjectReference Include="../../../src/Kernel/Iron.Kernel.Security/Iron.Kernel.Security.csproj" />
    <ProjectReference Include="../../../src/Kernel/Iron.Kernel.Audit/Iron.Kernel.Audit.csproj" />
    <ProjectReference Include="../../../src/Kernel/Iron.Kernel.Audit/Contracts/Iron.Kernel.Audit.Contracts.csproj" />
    <ProjectReference Include="../../../src/Kernel/Iron.Kernel.Authorization/Iron.Kernel.Authorization.csproj" />
    <ProjectReference Include="../../../src/Kernel/Iron.Kernel.Files/Iron.Kernel.Files.csproj" />
    <ProjectReference Include="../../../src/Kernel/Iron.Kernel.Files/Contracts/Iron.Kernel.Files.Contracts.csproj" />
    <ProjectReference Include="../../../src/Kernel/Iron.Kernel.Fleet/Iron.Kernel.Fleet.csproj" />
    <ProjectReference Include="../../../src/Kernel/Iron.Kernel.Fleet/Contracts/Iron.Kernel.Fleet.Contracts.csproj" />
    <ProjectReference Include="../../../src/Kernel/Iron.Kernel.Tenancy/Iron.Kernel.Tenancy.csproj" />
    <ProjectReference Include="../../../src/Kernel/Iron.Kernel.Tenancy/Contracts/Iron.Kernel.Tenancy.Contracts.csproj" />
  </ItemGroup>

</Project>
