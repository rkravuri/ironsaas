<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tests of the pure rules, and integration tests against a throw-away PostgreSQL container (needs Docker). -->
  <PropertyGroup>
    <IronLayer>Test</IronLayer>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Iron.Testing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Iron.Testing/Iron.Testing.csproj" />
    <ProjectReference Include="../../../src/Kernel/Iron.Kernel/Iron.Kernel.csproj" />
    <ProjectReference Include="../../../src/Kernel/Iron.Kernel.Data/Iron.Kernel.Data.csproj" />
    <!-- The key service on OpenBao's transit engine, for the encrypted fields (ADR-0054). -->
    <ProjectReference Include="../../../src/Kernel/Iron.Kernel.Security/Iron.Kernel.Security.csproj" />
  </ItemGroup>

</Project>
