<Project Sdk="Microsoft.NET.Sdk">

  <!-- Settings against a PostgreSQL container (needs Docker): declarations and rules, the resolution order, saving with its audit, the 30-second cache, secret references, the scoped permission, and an undeclared key that does not compile. -->
  <PropertyGroup>
    <IronLayer>Test</IronLayer>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Iron.Testing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Iron.Testing/Iron.Testing.csproj" />
    <ProjectReference Include="../../../src/Kernel/Iron.Kernel/Iron.Kernel.csproj" />
    <ProjectReference Include="../../../src/Kernel/Iron.Kernel.Data/Iron.Kernel.Data.csproj" />
    <ProjectReference Include="../../../src/Kernel/Iron.Kernel.Api/Iron.Kernel.Api.csproj" />
    <ProjectReference Include="../../../src/Kernel/Iron.Kernel.Telemetry/Iron.Kernel.Telemetry.csproj" />
    <ProjectReference Include="../../../src/Kernel/Iron.Kernel.Security/Iron.Kernel.Security.csproj" />
    <ProjectReference Include="../../../src/Kernel/Iron.Kernel.Audit/Iron.Kernel.Audit.csproj" />
    <ProjectReference Include="../../../src/Kernel/Iron.Kernel.Audit/Contracts/Iron.Kernel.Audit.Contracts.csproj" />
    <ProjectReference Include="../../../src/Kernel/Iron.Kernel.Authorization/Iron.Kernel.Authorization.csproj" />
    <ProjectReference Include="../../../src/Kernel/Iron.Kernel.Authorization/Contracts/Iron.Kernel.Authorization.Contracts.csproj" />
    <ProjectReference Include="../../../src/Kernel/Iron.Kernel.Identity/Contracts/Iron.Kernel.Identity.Contracts.csproj" />
    <ProjectReference Include="../../../src/Kernel/Iron.Kernel.Settings/Iron.Kernel.Settings.csproj" />
    <ProjectReference Include="../../../src/Kernel/Iron.Kernel.Settings/Contracts/Iron.Kernel.Settings.Contracts.csproj" />
  </ItemGroup>

</Project>
