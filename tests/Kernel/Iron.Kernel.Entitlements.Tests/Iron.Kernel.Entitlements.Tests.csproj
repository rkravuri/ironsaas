<Project Sdk="Microsoft.NET.Sdk">

  <!-- The unit's entitlements against a PostgreSQL container (needs Docker): the refresh, the last known answer, the checks in the API and seats. -->
  <PropertyGroup>
    <IronLayer>Test</IronLayer>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/Kernel/Iron.Kernel/Iron.Kernel.csproj" />
    <ProjectReference Include="../../../src/Kernel/Iron.Kernel.Data/Iron.Kernel.Data.csproj" />
    <ProjectReference Include="../../../src/Kernel/Iron.Kernel.Api/Iron.Kernel.Api.csproj" />
    <ProjectReference Include="../../../src/Kernel/Iron.Kernel.Telemetry/Iron.Kernel.Telemetry.csproj" />
    <ProjectReference Include="../../../src/Kernel/Iron.Kernel.Security/Iron.Kernel.Security.csproj" />
    <ProjectReference Include="../../../src/Kernel/Iron.Kernel.Audit/Iron.Kernel.Audit.csproj" />
    <ProjectReference Include="../../../src/Kernel/Iron.Kernel.Audit/Contracts/Iron.Kernel.Audit.Contracts.csproj" />
    <ProjectReference Include="../../../src/Kernel/Iron.Kernel.Authorization/Iron.Kernel.Authorization.csproj" />
    <ProjectReference Include="../../../src/Kernel/Iron.Kernel.Authorization/Contracts/Iron.Kernel.Authorization.Contracts.csproj" />
    <ProjectReference Include="../../../src/Kernel/Iron.Kernel.Entitlements/Iron.Kernel.Entitlements.csproj" />
    <ProjectReference Include="../../../src/Kernel/Iron.Kernel.Entitlements/Contracts/Iron.Kernel.Entitlements.Contracts.csproj" />
    <ProjectReference Include="../../../src/Kernel/Iron.Kernel.Flags/Iron.Kernel.Flags.csproj" />
  </ItemGroup>

</Project>
