<Project Sdk="Microsoft.NET.Sdk">

  <!-- Starts each of the four hosts in memory with its real module list: the start-up checks pass, the tenant binding holds, and the anonymous allow-list is the fixed one. No database. -->
  <PropertyGroup>
    <IronLayer>Test</IronLayer>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Iron.Testing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Iron.Testing/Iron.Testing.csproj" />
    <ProjectReference Include="../../src/Kernel/Iron.Kernel.Api/Iron.Kernel.Api.csproj" />
    <ProjectReference Include="../../src/Hosts/Iron.Host.Api/Iron.Host.Api.csproj" />
    <ProjectReference Include="../../src/Hosts/Iron.Host.Worker/Iron.Host.Worker.csproj" />
    <ProjectReference Include="../../src/Hosts/Iron.Host.ControlPlane/Iron.Host.ControlPlane.csproj" />
    <ProjectReference Include="../../src/Hosts/Iron.Host.Fleet/Iron.Host.Fleet.csproj" />
  </ItemGroup>

</Project>
